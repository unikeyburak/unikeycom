APP_NAME="Unikeyterra"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=tr
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=tr_TR
APP_LOCALE_COOKIE=site_locale
APP_DIRECTION_COOKIE=site_direction
APP_LOCALE_COOKIE_MINUTES=43200

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=unikeyterra_db
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
MEDIA_DISK=public
QUEUE_CONNECTION=database

CACHE_STORE=file
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# GeoIP
GEOIP_LOOKUP_ENABLED=true
GEOIP_TIMEOUT=1.5
GEOIP_CACHE_SECONDS=86400

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="info@unikeyterra.net"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# CRM Integration Settings
CRM_BASE_URL=
CRM_API_KEY=
CRM_WEBHOOK_SECRET=

# CORS Settings  
CORS_ALLOWED_ORIGINS="http://localhost:8080,https://unikeyterra.net"
CORS_ALLOWED_METHODS="GET,POST,PUT,DELETE,OPTIONS"
CORS_ALLOWED_HEADERS="Content-Type,Authorization,X-Requested-With,X-XSRF-TOKEN"

# Security
APP_FORCE_HTTPS=false
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax

# Public Page Cache (CDN/Cloudflare/LiteSpeed)
PUBLIC_CACHE_ENABLED=false
PUBLIC_CACHE_MAX_AGE=300
PUBLIC_CACHE_S_MAXAGE=3600
PUBLIC_CACHE_STALE=86400
