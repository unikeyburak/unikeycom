    protected function getFormActions(): array
    {
        return [
            Action::make('save')
                ->label('Kaydet')
                ->submit('save'),
        ];
    }

    public function save(): void
    {
        $data = $this->form->getState();

        // Ayarları kaydet
        foreach ($data as $key => $value) {
            $type = 'text';
            
            // JSON olarak kaydedilmesi gereken alanlar
            if (in_array($key, ['header_menu', 'footer_columns', 'social_media', 'hero_slides', 'mega_menu'])) {
                $type = 'json';
            }
            
            // Boolean alanlar
            if (in_array($key, ['header_show_phone', 'header_show_email'])) {
                $type = 'boolean';
            }

            // Integer alanlar
            if (in_array($key, ['hero_slider_autoplay'])) {
                $type = 'integer';
            }
            
            if ($value !== null) {
                Setting::set($key, $value, $type);
            }
        }

        Notification::make()
            ->title('Ayarlar kaydedildi')
            ->success()
            ->send();
    }
}
